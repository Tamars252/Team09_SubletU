# Copy to server/.env and adjust. All values have working defaults for local dev.

PORT=4000
# Comma-separated list of origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# Secret used to sign session tokens (HS256). CHANGE THIS IN PRODUCTION.
JWT_SECRET=dev-only-change-me
JWT_TTL_HOURS=720

# Secret used to encrypt ScreenSettings payloads at rest (AES-256-GCM).
SETTINGS_SECRET=dev-only-change-me-too

# SQLite file. Created automatically.
DATABASE_FILE=./data/subletu.db

# Where uploaded listing photos are written.
UPLOAD_DIR=./uploads
MAX_PHOTO_BYTES=6291456

# Nominatim (OpenStreetMap) geocoding. Free, no key. Be a good citizen:
# max 1 req/sec and a real contact in the User-Agent.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=SubletU/1.0 (CIS-453 course project; tmhaque@syr.edu)
