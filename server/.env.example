# Copy to server/.env and adjust. All values have working defaults for local dev.

PORT=4000
# Comma-separated list of origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# Secret used to sign session tokens (HS256). CHANGE THIS IN PRODUCTION.
JWT_SECRET=dev-only-change-me
JWT_TTL_HOURS=720

# Secret used to encrypt ScreenSettings payloads at rest (AES-256-GCM).
SETTINGS_SECRET=dev-only-change-me-too

# SQLite file. Created automatically.
DATABASE_FILE=./data/subletu.db

# Where uploaded listing photos are written.
UPLOAD_DIR=./uploads
MAX_PHOTO_BYTES=6291456

# Nominatim (OpenStreetMap) geocoding. Free, no key. Be a good citizen:
# max 1 req/sec and a real contact in the User-Agent.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=SubletU/1.0 (CIS-453 course project; tmhaque@syr.edu)

# Public origin of the app. Password-reset links and the Microsoft redirect URI
# are built from this, so it must match how people actually reach the site.
APP_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Microsoft Entra ID (Syracuse SSO)
# ---------------------------------------------------------------------------
# Leave MS_CLIENT_ID/MS_CLIENT_SECRET empty and set SSO_DEV_MODE=true to use the
# local stand-in, which exercises the whole flow without an app registration.
# The server refuses to start with SSO_DEV_MODE=true and NODE_ENV=production.
SSO_DEV_MODE=true

# From the app registration. MS_TENANT_ID should be Syracuse's directory (GUID)
# so tokens from any other tenant are rejected at the issuer. "organizations"
# accepts any work/school tenant and leans entirely on SSO_ALLOWED_DOMAINS.
MS_TENANT_ID=organizations
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Must match the redirect URI registered in Azure, exactly.
MS_REDIRECT_URI=http://localhost:4000/api/auth/sso/callback

# Only these email domains may sign in. Comma-separated.
SSO_ALLOWED_DOMAINS=syr.edu

# ---------------------------------------------------------------------------
# Email (password resets)
# ---------------------------------------------------------------------------
# With no key, reset links are printed to the server log instead of sent, which
# is fine locally. Production refuses to start without one.
RESEND_API_KEY=
MAIL_FROM=SubletU <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# Password policy
# ---------------------------------------------------------------------------
# Length is the only composition rule, per NIST SP 800-63B; a blocklist catches
# the common choices instead of demanding symbols.
PASSWORD_MIN_LENGTH=12
RESET_TOKEN_MINUTES=45

# Where verification codes and reset links are written as JSON, in addition to
# being sent. Used by the end-to-end suite; leave empty otherwise.
MAIL_LOG_FILE=
