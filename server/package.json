{
  "name": "@subletu/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --no-warnings=ExperimentalWarning src/index.ts",
    "start": "node --no-warnings=ExperimentalWarning src/index.ts",
    "seed": "node --no-warnings=ExperimentalWarning src/seed.ts",
    "test": "node --test --no-warnings=ExperimentalWarning \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "validate:sample": "node --no-warnings=ExperimentalWarning scripts/validate-sample-listings.ts",
    "seed:sample": "npm run seed",
    "docs:sample": "node --no-warnings=ExperimentalWarning scripts/write-sample-docs.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
